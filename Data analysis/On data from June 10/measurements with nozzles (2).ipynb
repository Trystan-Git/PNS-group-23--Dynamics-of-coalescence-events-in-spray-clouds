   "metadata": {},
   "outputs": [],
   "source": [
    "diam = [179.76864624, 184.3699646, 177.406326294, 246.732009888, 254.487854004, 491.828399658]\n",
    "a_diam = [d / (1.91 * noz) for d, noz in zip(diam, noz_ID)]\n"
   ]
  },
