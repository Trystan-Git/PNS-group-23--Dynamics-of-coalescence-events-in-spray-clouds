     ]
    }
   ],
   "source": [
    "a = 10.6407982\n",
    "b = 9.17514783\n",
    "noz_ID = [32,32,32,64,64,64]\n",
    "\n",
    "normalised_x = [\n",
    "    (10 / (4.5 * noz * 10**-4)) * (a + b)\n",
    "    for noz in noz_ID\n",
    "]\n",
    "\n",
    "print(normalised_x)"
   ]
  },
